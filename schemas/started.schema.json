{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nbardy/oompa_loompas/schemas/started.schema.json",
  "title": "OompaStarted",
  "description": "Swarm started event. Written once at swarm start. File: runs/{swarm-id}/started.json",
  "type": "object",
  "required": ["swarm-id", "started-at", "pid", "config-file", "workers"],
  "properties": {
    "swarm-id": { "type": "string" },
    "started-at": { "type": "string", "format": "date-time" },
    "pid": { "type": "integer", "description": "Orchestrator process ID for liveness checks" },
    "config-file": { "type": "string" },
    "continuation-control-dir": { "type": ["string", "null"], "description": "OOMPA_CONTINUATION_CONTROL_DIR at start, when a host continuation channel is attached" },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "harness", "model", "max-cycles", "can-plan", "prompts", "reviewers"],
        "properties": {
          "id": { "type": "string" },
          "harness": {
            "oneOf": [
              { "type": "string", "enum": ["codex", "claude", "opencode", "gemini"] },
              { "type": "string", "pattern": "^gemini\\d+$" }
            ]
          },
          "model": { "type": "string" },
          "reasoning": { "type": ["string", "null"] },
          "max-cycles": { "type": "integer", "minimum": 1, "description": "Max completed cycles (terminal outcomes) before worker stops" },
          "max-resumes": { "type": "integer", "minimum": 1, "description": "Max attempts/resumes within a single cycle (default 7)" },
          "can-plan": { "type": "boolean" },
          "prompts": { "type": "array", "items": { "type": "string" } },
          "reviewers": {
            "type": "array",
            "description": "Resolved reviewers for this worker (worker-level plus inherited top-level); empty when review is disabled. Salvage rebuilds its review gate from this list.",
            "items": {
              "type": "object",
              "required": ["harness", "model", "reasoning", "prompts"],
              "properties": {
                "harness": {
                  "oneOf": [
                    { "type": "string", "enum": ["codex", "claude", "opencode", "gemini"] },
                    { "type": "string", "pattern": "^gemini\\d+$" }
                  ]
                },
                "model": { "type": "string" },
                "reasoning": { "type": ["string", "null"] },
                "prompts": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "planner": {
      "type": ["object", "null"],
      "properties": {
        "harness": {
          "oneOf": [
            { "type": "string", "enum": ["codex", "claude", "opencode", "gemini"] },
            { "type": "string", "pattern": "^gemini\\d+$" }
          ]
        },
        "model": { "type": "string" },
        "prompts": { "type": "array", "items": { "type": "string" } },
        "max-pending": { "type": "integer", "minimum": 1 }
      },
      "required": ["harness", "model", "prompts", "max-pending"]
    }
  },
  "additionalProperties": false
}
